{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'"
        }
      ]
    },
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/downloads/Jarvis-0.2.0-windows-x64.zip",
      "destination": "https://github.com/MohanChippala123/jarvis-local/releases/download/v0.2.0/Jarvis-0.2.0-windows-x64.zip",
      "permanent": true
    },
    {
      "source": "/downloads/Jarvis-0.3.0-windows-x64.zip",
      "destination": "https://github.com/MohanChippala123/jarvis-local/releases/download/v0.3.0/Jarvis-0.3.0-windows-x64.zip",
      "permanent": true
    }
  ]
}